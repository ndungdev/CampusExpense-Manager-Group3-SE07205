<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý Ngân sách"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etBudgetAmount"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nhập ngân sách (VNĐ)"
        android:inputType="numberDecimal"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveBudget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu Ngân Sách"
        android:backgroundTint="#FF9800"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvTotalSpent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đã chi: 0 đ"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvBudgetStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Còn lại: ..."
        android:textSize="16sp"/>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="BACK"
        android:backgroundTint="#606060"/>
</LinearLayout>